class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] ans = new int[2 * n];

        int index = 0;

        for (int i = 0; i < n; i++) {
            ans[index++] = nums[i];       // x1, x2, x3...
            ans[index++] = nums[i + n];   // y1, y2, y3...
        }

        return ans;
    }
}
 
        
    
